# ===========================================
# إعدادات Paymob - الأكاديمية الدولية للتدريب والاستشارات العلمية
# انسخ هذا الملف إلى .env واملأ القيم من لوحة Paymob
# ===========================================

# مفتاح API (من Settings > Account Info)
PAYMOB_API_KEY=your_api_key_here

# رقم التكامل للبطاقات (Visa/Mastercard) - من Payment Integrations
PAYMOB_CARD_INTEGRATION_ID=0000000

# رقم التكامل للمحافظ الإلكترونية (اختياري - إن وُجد)
PAYMOB_WALLET_INTEGRATION_ID=0000000

# رقم الـ iFrame (من iFrames في لوحة Paymob)
PAYMOB_IFRAME_ID=000000

# مفتاح HMAC للتحقق من الـ Webhooks (من Settings)
PAYMOB_HMAC_SECRET=your_hmac_secret_here

# وضع التجربة: true = Test Mode | false = Live Mode
PAYMOB_TEST_MODE=true

# رابط موقعك العام (مطلوب للـ callback)
# مثال محلي: http://localhost:3000
# مثال إنتاج: https://yourdomain.com
BASE_URL=http://localhost:3000

# منفذ الخادم
PORT=3000

# السماح بأصل الواجهة (CORS) - ضع رابط الواجهة إن كانت منفصلة
CORS_ORIGIN=*

